[Unit]
Description=Pin the default sink to the Atlas internal MAX98373 speakers
After=wireplumber.service pipewire-pulse.socket

[Service]
Type=oneshot
# The speaker sink can appear slightly after WirePlumber starts (and HDMI may
# win the default-node race).  Wait for it, then pin the default output.
ExecStart=/bin/sh -c 'for i in $(seq 1 30); do pactl get-sink-volume alsa_output.platform-avs_max98373.18.auto.HiFi__Speaker__sink >/dev/null 2>&1 && break; sleep 1; done; exec pactl set-default-sink alsa_output.platform-avs_max98373.18.auto.HiFi__Speaker__sink'
RemainAfterExit=yes

[Install]
WantedBy=default.target
